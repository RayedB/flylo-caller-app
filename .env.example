# xAI — https://console.x.ai
XAI_API_KEY=
# Voice: eve | ara | rex | sal | leo, or a custom voice id from your team's voice library
XAI_VOICE_ID=eve

# FlyLo booking backend (local default for the demo pipeline)
FLYLO_API_BASE_URL=http://localhost:8787
FLYLO_API_KEY=

# Local Chatwoot (see ../flylo-ops)
CHATWOOT_BASE_URL=http://localhost:3001
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_USER_ACCESS_TOKEN=

# Callbacks: signs Chatwoot -> app webhooks. Set by `npm run chatwoot:webhook`.
CHATWOOT_WEBHOOK_SECRET=
# Where Chatwoot (in Docker) reaches this app. Default shown.
# CHATWOOT_WEBHOOK_TARGET_URL=http://host.docker.internal:3000/api/chatwoot/webhook

# Optional: notify triage if Chatwoot webhooks cannot reach the host
TRIAGE_FALLBACK_URL=http://localhost:4001/hooks/ticket
